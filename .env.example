# ────────────────────────────────────────────────
# Super Admin (bootstrap) — /api/v1/auth/seed-admin y login auto-curativo
# ────────────────────────────────────────────────
# SUPER_ADMIN_EMAIL define el correo del super admin.
#   (default si se omite: anchillo00@gmail.com)
# SUPER_ADMIN_PASSWORD define la contraseña de arranque. En cada intento de
#   login con ese correo, el usuario se crea/actualiza con este hash, así que
#   el acceso funciona aunque la BD no esté sembrada. Cámbiala en producción.
SUPER_ADMIN_EMAIL=anchillo00@gmail.com
SUPER_ADMIN_PASSWORD=Mineria99*
