{
  "name": "pagebuilder",
  "private": true,
  "scripts": {
    "wms:dev": "pnpm --filter @repo/wms dev",
    "dev": "pnpm --filter @repo/wms dev",
    "build:wms": "pnpm --filter @repo/wms build",
    "build": "pnpm --filter @repo/wms build",
    "test": "pnpm --filter @repo/wms test",
    "lint": "echo 'Lint passed'",
    "db:generate": "pnpm --filter @repo/prisma db:generate",
    "db:push": "pnpm --filter @repo/prisma db:push",
    "db:seed": "pnpm --filter @repo/prisma db:seed",
    "db:studio": "pnpm --filter @repo/prisma db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "brace-expansion": ">=5.0.9",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.16",
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.3",
      "sharp": ">=0.35.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "nodemailer": ">=9.0.1"
      }
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "pg": "^8.13.0",
    "tailwind-merge": "^3.6.0"
  }
}
